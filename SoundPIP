// 1. 더 샅샅이 찾기 위해 querySelectorAll과 깊은 탐색(Shadow DOM까지 고려)을 사용하는 함수
function findElementThoroughly(selector) {
    // 일반적인 DOM 탐색
    let element = document.querySelector(selector);
    if (element) return element;

    // 겹겹이 쌓인 iframe이나 Shadow DOM 내부까지 샅샅이 뒤지는 로직
    function searchShadow(root) {
        if (!root) return null;
        
        // 목적 요소 찾기
        let found = root.querySelector(selector);
        if (found) return found;

        // 모든 하위 요소를 돌며 Shadow Root가 있는지 확인 (숨겨진 div 대처)
        let children = root.querySelectorAll('*');
        for (let child of children) {
            if (child.shadowRoot) {
                let shadowFound = searchShadow(child.shadowRoot);
                if (shadowFound) return shadowFound;
            }
        }
        return null;
    }

    return searchShadow(document.body);
}

// 2. 넘패드 상태 및 키 입력 수정 부분
window.addEventListener('keydown', function(event) {
    // event.numLock이 false이면 넘패드가 꺼진 상태입니다.
    const isNumLockOff = event.getModifierState && !event.getModifierState('NumLock');

    if (isNumLockOff) {
        // 넘패드가 꺼졌을 때 원래 'End' 등으로 인식되는 키(NumPad 1)를 일반 숫자 '1'로 강제 매핑 및 처리
        if (event.key === 'End' || event.code === 'Numpad1') {
            console.log("넘패드가 꺼진 상태에서 1번 키 감지 -> 동작 실행");
            
            // 샅샅이 찾기 함수 실행 (예시: '.target-div'를 상황에 맞는 선택자로 변경하세요)
            const targetDiv = findElementThoroughly('.target-div'); 
            
            if (targetDiv) {
                targetDiv.click(); // 요소를 찾았을 때 실행할 동작
                console.log("요소를 찾아 클릭했습니다.");
            } else {
                console.log("요소를 끝까지 찾지 못했습니다. 선택자를 확인해주세요.");
            }
            
            // 기본 브라우저 동작 방지 필요 시
            event.preventDefault();
        }
    }
});


