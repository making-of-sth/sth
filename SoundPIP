    window.addEventListener('keydown', function(event) {
        // 넘패드 5번 키 (NumLock이 꺼져 있을 때의 키 이름은 'Clear'입니다)
        if (event.key === 'Clear' || event.code === 'Numpad5') {
            event.preventDefault(); // 브라우저 기본 동작 방지
            
            // 토글 로직
            if (!isSlow) {
                window.myTargetAudio.playbackRate = 0.5;
                isSlow = true;
                console.log("재생 속도: 0.5배속");
